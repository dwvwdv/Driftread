{
  "manifest_version": 3,
  "name": "Driftread — Add to Driftread",
  "version": "0.2.0",
  "description": "在任何網站上偵測 RSS / Atom feed，一鍵加入 Driftread 漂流閱讀。",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [],
  "action": {
    "default_title": "Add to Driftread",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
