# Supabase Cloud 專案設定
# 從 Supabase Dashboard → Settings → API 取得
SUPABASE_URL=https://your-project-id.supabase.co

# ⚠ Backend 專用：請填 service_role key（不是 anon key）
# Backend 需要繞過 RLS 來寫入 feeds / articles，並用自己的 JWT 驗證 + ADMIN_API_KEY 控管權限。
# service_role key 絕對不可暴露給瀏覽器；前端在 frontend/src/environments/ 另外設定 anon key。
SUPABASE_KEY=your-service-role-key

# Supabase 直連 PostgreSQL（用於 migration）
# 從 Supabase Dashboard → Settings → Database → Connection string (URI) 取得
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase JWT Secret（驗證用戶 token；必填）
# 從 Supabase Dashboard → Settings → API → JWT Settings 取得
SUPABASE_JWT_SECRET=

# Driftread 管理員 API Key（隨機產生即可）
ADMIN_API_KEY=

# CORS 允許的來源（逗號分隔），預設開放所有
# CORS_ORIGINS=https://driftread.lazyrhythm.com

# 所有對外抓取（探測、匯入、排程更新、自主發現）使用的 User-Agent，預設 Driftread/1.0
# 建議帶上聯絡網址，讓被抓取的站方能找到你要求停止；robots.txt 的 User-agent
# 比對只看第一個 "/" 之前的字，所以加括號註記不會影響 robots 匹配。
# DISCOVERY_USER_AGENT=Driftread/1.0 (+https://driftread.lazyrhythm.com/about)

# 日誌等級（worker 讀取），預設 INFO
# LOG_LEVEL=INFO

# ── 自動抓取排程（worker 容器）─────────────────────────────────────
# 以下全部有預設值，不填也能正常運作。

# 是否啟用排程。設為 false 時 worker 記一行 log 後直接退出（api 不受影響）。
# FEED_REFRESH_ENABLED=true

# 每輪掃描到期佇列的間隔（秒）。這不是抓取頻率 —— 個別 feed 的間隔由
# feeds.fetch_interval_minutes 自適應決定，這只是「多久檢查一次有誰到期」。
# FEED_REFRESH_TICK_SECONDS=300

# 單輪最多處理幾個到期的 feed
# FEED_REFRESH_BATCH_SIZE=50

# 單輪同時對外抓取的上限，避免大量源同時湧出
# FEED_REFRESH_CONCURRENCY=5

# 個別 feed 抓取間隔的下限 / 上限（分鐘）。有新文章的源間隔對半縮短，
# 沒動靜或抓取失敗的源間隔加倍，並夾在這兩個值之間。
# FEED_REFRESH_MIN_INTERVAL_MINUTES=15
# FEED_REFRESH_MAX_INTERVAL_MINUTES=1440

# ── 自主發現新 RSS 源（worker 容器）───────────────────────────────────
# 以下全部有預設值，不填也能正常運作。
#
# ⚠ 這是唯一一組預設「關閉」的排程。FEED_REFRESH_* 只碰你自己匯入的源，
#   自主發現則會主動去探測沒人要求過的第三方網站 —— 拉了新版 image 不該
#   默默變成一台爬蟲。啟用前請先讀 docs/SECURITY.md 的自主發現章節，
#   特別是 DNS rebinding 那一節。

# 總開關。false 時 worker 不跑發現迴圈，且 POST /api/admin/discovery/run 回 503
# （這個 flag 是真的 kill switch，與 FEED_REFRESH_ENABLED 不同）。
# FEED_DISCOVERY_ENABLED=false

# 每輪發現週期的間隔（秒）
# FEED_DISCOVERY_TICK_SECONDS=900

# 每輪從幾個既有 feed 挖掘文章外連（此路徑零網路請求，只讀本地 articles）
# FEED_DISCOVERY_HARVEST_BATCH_SIZE=10

# 每個 feed 掃最近幾篇文章
# FEED_DISCOVERY_HARVEST_ARTICLES=20

# 同一個 feed 多久後再挖一次（小時）。外連集合變動遠比文章列表慢。
# FEED_DISCOVERY_HARVEST_INTERVAL_HOURS=168

# 單一 feed 每輪最多貢獻幾個新網域，防止灌水源塞爆待探測佇列
# FEED_DISCOVERY_HARVEST_MAX_LINKS_PER_FEED=200

# 是否額外抓取各 feed 的網站首頁、挖友情連結（blogroll）。
# 預設關閉：這是文章挖掘之外的另一類對外流量。
# FEED_DISCOVERY_BLOGROLL_ENABLED=false

# 是否抓取 discovery_sources 裡的目錄頁（awesome 清單、OPML 目錄）。
# 預設關閉，理由同上。用 POST /api/admin/discovery/sources 維護清單。
# FEED_DISCOVERY_DIRECTORY_ENABLED=false
# FEED_DISCOVERY_DIRECTORY_BATCH_SIZE=3

# 單輪最多探測幾個待探測目標、同時對外幾條連線
# FEED_DISCOVERY_PROBE_BATCH_SIZE=20
# FEED_DISCOVERY_PROBE_CONCURRENCY=3

# 連續探測失敗幾次後放棄該目標，以及重試的基礎間隔（小時，之後逐次加倍）
# FEED_DISCOVERY_PROBE_MAX_ATTEMPTS=3
# FEED_DISCOVERY_PROBE_RETRY_HOURS=24

# 對同一個網站連續請求之間的禮貌間隔（秒）。robots.txt 宣告更長的
# Crawl-delay 時以它為準，上限 30 秒。
# FEED_DISCOVERY_HOST_DELAY_SECONDS=2

# 是否遵守 robots.txt。預設開啟。關閉後合規責任由你自負，另外會失去
# 「站台是否可達」的信號，讓重試判斷變粗糙（見 docs/FEATURES.md）。
# FEED_DISCOVERY_RESPECT_ROBOTS=true

# 待探測佇列的上限。超過後仍會累積既有目標的證據，但不再新增目標。
# FEED_DISCOVERY_MAX_FRONTIER_SIZE=50000

# 有幾個「不同的」既有源連到某個候選時，直接自動入庫、跳過人工審核。
# 0 = 永不自動（全部進後台審核佇列）。
# FEED_DISCOVERY_AUTO_PROMOTE_MIN_REFERRERS=0
