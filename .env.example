# Copy this file to .env and fill in your values:
#   cp .env.example .env

###############################################################################
# PostgreSQL
###############################################################################
POSTGRES_PASSWORD=your-super-secret-postgres-password

###############################################################################
# JWT
# Production: replace with a random 32+ character string, then re-sign the
# ANON_KEY and SERVICE_ROLE_KEY JWTs using the new secret.
# The values below are the well-known Supabase local-dev defaults and are
# NOT secret — do not use them in production.
###############################################################################
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7b9PKHm_B0kF3SgTOC3j7WYFZrxz98qJQY0

SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0

###############################################################################
# Application
###############################################################################
ADMIN_API_KEY=your-secret-admin-key

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost

# Public URL of the deployment (used by GoTrue and Studio)
SITE_URL=http://localhost
API_EXTERNAL_URL=http://localhost
