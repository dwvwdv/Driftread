# Supabase Cloud 專案設定
# 從 Supabase Dashboard → Settings → API 取得
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key

# Supabase PostgreSQL 連線（用於啟動時自動 migration）
# ⚠ 必須使用 Session Pooler URL（IPv4），不要用 Direct Connection（IPv6 可能不通）
# 從 Supabase Dashboard → Settings → Database → Connection pooling → Session mode 取得
# 格式：postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=

# Driftread 管理員 API Key（隨機產生即可）
ADMIN_API_KEY=

# CORS 允許的來源（逗號分隔），預設開放所有
# CORS_ORIGINS=https://driftread.lazyrhythm.com
