# =============================================================================
# 先執行以下指令生成所有 key，再將輸出貼入此檔案（存為 .env）：
#
#   python3 scripts/gen_keys.py
#
# ANON_KEY 和 SERVICE_ROLE_KEY 是以 JWT_SECRET 簽發的 JWT，
# 三個值必須配套——不可混用不同 secret 簽發的 key。
# =============================================================================

# PostgreSQL 密碼
POSTGRES_PASSWORD=

# JWT Secret（至少 40 字元隨機字串）
JWT_SECRET=

# Supabase API Keys（由 JWT_SECRET 簽發，用 gen_keys.py 生成）
ANON_KEY=
SERVICE_ROLE_KEY=

# Driftread 管理員 API Key
ADMIN_API_KEY=

# 前端 CORS 允許的來源（逗號分隔）
CORS_ORIGINS=http://localhost
