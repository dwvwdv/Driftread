# 透過 docker-compose 啟動時，後端環境變數由根目錄 .env 提供，此檔案無需設定。
#
# 若單獨執行後端（不透過 docker-compose），先執行 python3 scripts/gen_env.py 生成根目錄 .env，
# 再將對應值填入此處後存為 backend/.env。

SUPABASE_URL=http://localhost:8000
SUPABASE_KEY=<根目錄 .env 的 ANON_KEY>
ADMIN_API_KEY=<根目錄 .env 的 ADMIN_API_KEY>
CORS_ORIGINS=http://localhost:4200,http://localhost
