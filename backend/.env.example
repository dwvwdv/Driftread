# 透過 docker-compose 啟動時，後端環境變數由根目錄 .env 提供，此檔案無需設定。
#
# 若單獨執行後端（不透過 docker-compose），先執行 python3 scripts/gen_env.py 生成根目錄 .env，
# 再將對應值填入此處後存為 backend/.env。

SUPABASE_URL=<根目錄 .env 的 SUPABASE_URL>
SUPABASE_KEY=<根目錄 .env 的 SUPABASE_KEY (service_role；繞過 RLS 進行寫入)>
SUPABASE_JWT_SECRET=<根目錄 .env 的 SUPABASE_JWT_SECRET — 用於驗證用戶 token>
DATABASE_URL=<根目錄 .env 的 DATABASE_URL — 用於啟動時自動跑 migration>
ADMIN_API_KEY=<根目錄 .env 的 ADMIN_API_KEY>
CORS_ORIGINS=http://localhost:4200,http://localhost
DISCOVERY_USER_AGENT=Driftread/1.0
