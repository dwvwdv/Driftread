# When running via docker-compose, environment variables are supplied by the
# root .env file — this file is only needed if running the backend standalone.
#
# Copy to backend/.env:
#   cp backend/.env.example backend/.env

# Supabase — points to Kong gateway
# Inside docker-compose: http://kong:8000
